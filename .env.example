# cp .env.example .env

# Postgres. POSTGRES_URL is used as a fallback if this is unset.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Upstash Redis. Leave blank to run without a cache — it is read-through, so
# every path falls back to computing the value.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional
PORT=8080
SOLVER_TIME_BUDGET_MS=3000
PG_POOL_MAX=10
# CORS_ORIGINS=https://your-app.vercel.app
